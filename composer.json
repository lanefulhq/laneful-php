{
    "name": "lanefulhq/laneful-php",
    "description": "PHP client library for the Laneful email API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Laneful Team",
            "email": "support@laneful.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Laneful\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laneful\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src --level=8",
        "cs-check": "phpcs --standard=PSR12 src",
        "cs-fix": "phpcbf --standard=PSR12 src",
        "docker:build": "docker-compose build",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:shell": "docker-compose exec laneful-php bash",
        "docker:test": "docker-compose exec laneful-php composer test",
        "docker:phpstan": "docker-compose exec laneful-php composer phpstan",
        "docker:cs-check": "docker-compose exec laneful-php composer cs-check",
        "docker:cs-fix": "docker-compose exec laneful-php composer cs-fix"
    }
}
